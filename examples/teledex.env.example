# Teledex public configuration
# Copy to teledex.env, fill placeholders, then run:
#   npm run doctor -- --env-file teledex.env
#   npm start -- --env-file teledex.env

TELEDEX_BACKEND=app-server-v2
TELEDEX_ENABLE_APP_SERVER_V2=1

# Telegram Bot API token from BotFather.
TELEGRAM_BOT_TOKEN=replace-me

# Comma-separated Telegram user ids allowed to control this local Teledex.
# Use numeric ids from your own account; keep this allowlist tight.
TELEGRAM_ALLOWED_USER_IDS=replace-me

# Required forum-enabled Telegram supergroup id.
TELEGRAM_FORUM_CHAT_ID=replace-me

# Codez App Server v2.
CODEX_BIN_PATH=codex
CODEZ_APP_SERVER_URL=stdio://

# Local workspace and state. Use a dedicated workspace for trusted operators.
TELEDEX_WORKSPACE_ROOT=../teledex-workspace
TELEDEX_STATE_ROOT=../teledex-state

# Optional runtime controls.
TELEDEX_MODEL=
TELEDEX_REASONING_EFFORT=
TELEDEX_UI_LANGUAGE=en
TELEDEX_MCP_PRESET=none
